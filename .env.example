# --- GitHub App (Alex's identity) ---
# Register a GitHub App (see SETUP.md), then fill these in.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Or inline the PEM instead of a path:
# GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# The app's slug (from the app URL, e.g. "alex-coder" for @alex-coder).
GITHUB_APP_SLUG=alex

# --- Dashboard OAuth (uses the same GitHub App's OAuth credentials) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Comma-separated GitHub logins allowed into the dashboard.
DASHBOARD_ALLOWED_LOGINS=wbohanw
# Public base URL of this server (for the OAuth callback), e.g. https://alex.example.com
PUBLIC_BASE_URL=http://localhost:3900

# --- Remote OpenCode server ---
OPENCODE_URL=
OPENCODE_PASSWORD=

# --- Runtime ---
PORT=3900
DATA_DIR=~/.alex
LOG_LEVEL=info
TASK_TIMEOUT_MS=900000
MAX_CONCURRENT_TASKS=3
