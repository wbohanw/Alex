{
  "name": "alex",
  "version": "0.1.0",
  "description": "Alex — an autonomous coding agent you @-mention on GitHub. Plans, waits for approval, builds, opens PRs, and reviews changes through an OpenCode server.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "dev:ui": "cd packages/ui && bun run dev",
    "build:ui": "cd packages/ui && bun run build",
    "check:ui": "cd packages/ui && bun run check"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.29"
  }
}
